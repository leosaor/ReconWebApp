# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=ReconWebApp
ENVIRONMENT=development
DEBUG=false

# !! Gere um valor seguro: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Banco de dados ─────────────────────────────────────────────────────────────
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon
POSTGRES_DB=recon
DATABASE_URL=postgresql+psycopg://recon:recon@postgres:5432/recon

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS (separe múltiplas origens com vírgula) ────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
